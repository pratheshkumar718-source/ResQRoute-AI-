# Optional simulation settings
# RESQ_SIM_TICK=1.0     # seconds between simulated ambulance position updates
# RESQ_AUTOSIM=1        # set 0 to disable background movement (used by tests)
# RESQ_DATA_DIR=backend/data

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Database connection strings
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# PyTorch Deep Learning Model Configuration
ACCIDENT_MODEL_PATH=C:\Prathesh\resqroute-ai\resqroute-ai\backend\resqroute_accident_model.pt
MODEL_CONFIG_PATH=C:\Prathesh\resqroute-ai\resqroute-ai\backend\model_config.json

# Frontend (Vite) Environment Variables
VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
